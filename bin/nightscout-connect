#!/usr/bin/env node

// Must load before yargs pulls in the commands, so nothing logs unscrubbed.
require('../lib/log-scrub').install( );

var argv = require('yargs')
  .scriptName('nightscout-connect')
  .usage('$0 <cmd> [args]')
  .env("CONNECT")
  .commandDir('../commands')
  .command(require('../demo'))
  .help( )
  .completion( )
  .argv;

