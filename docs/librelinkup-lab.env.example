# Private LOCAL accounts only. Copy is created at .local/librelinkup/.env.
# Use neutral aliases; one alias/database per patient. Keep passwords quoted.
# Blank accounts are skipped. Partial credentials fail. Comments stay comments.
# Add aliases (up to 12) and matching LLU_<ALIAS>_* settings as needed.
LLU_TEST_ACCOUNTS=uk,eu,us,ca,au,ap

LLU_UK_USERNAME=""
LLU_UK_PASSWORD=""
LLU_UK_PATIENT_ID=""
LLU_UK_REGION=EU2
LLU_UK_TIMEZONE=Europe/London
LLU_UK_UNITS=mmol
LLU_UK_MAX_AGE_MINUTES=30
LLU_UK_SENSOR_INFO=true
LLU_UK_STEALTH_TLS=false

LLU_EU_USERNAME=""
LLU_EU_PASSWORD=""
LLU_EU_PATIENT_ID=""
LLU_EU_REGION=EU
LLU_EU_TIMEZONE=Europe/Berlin
LLU_EU_UNITS=mmol

LLU_US_USERNAME=""
LLU_US_PASSWORD=""
LLU_US_PATIENT_ID=""
LLU_US_REGION=US
LLU_US_TIMEZONE=America/New_York
LLU_US_UNITS="mg/dl"

LLU_CA_USERNAME=""
LLU_CA_PASSWORD=""
LLU_CA_PATIENT_ID=""
LLU_CA_REGION=CA
LLU_CA_TIMEZONE=America/Toronto
LLU_CA_UNITS=mmol

LLU_AU_USERNAME=""
LLU_AU_PASSWORD=""
LLU_AU_PATIENT_ID=""
LLU_AU_REGION=AU
LLU_AU_TIMEZONE=Australia/Sydney
LLU_AU_UNITS=mmol

LLU_AP_USERNAME=""
LLU_AP_PASSWORD=""
LLU_AP_PATIENT_ID=""
LLU_AP_REGION=AP
LLU_AP_TIMEZONE=Asia/Singapore
LLU_AP_UNITS=mmol
