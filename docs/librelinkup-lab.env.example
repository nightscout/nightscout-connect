# Private LOCAL accounts only. Copy is created at .local/librelinkup/.env.
# Use neutral aliases; one alias/database per patient. Keep passwords quoted.
# Blank accounts are skipped. Partial credentials fail. Comments stay comments.
# Each REGION selects its built-in Abbott endpoint; no custom server is needed.
# Up to 13 aliases: one for every supported regional endpoint.
# Region is a starting choice. Login may redirect an account to another region.
LLU_TEST_ACCOUNTS=uk,eu,us,ca,au,ap,ae,la,ru,jp,cn,de,fr

LLU_UK_USERNAME=""
LLU_UK_PASSWORD=""
LLU_UK_PATIENT_ID=""
LLU_UK_REGION=EU2
LLU_UK_TIMEZONE=Europe/London
LLU_UK_UNITS=mmol
LLU_UK_MAX_AGE_MINUTES=30
LLU_UK_SENSOR_INFO=true
LLU_UK_STEALTH_TLS=false

LLU_EU_USERNAME=""
LLU_EU_PASSWORD=""
LLU_EU_PATIENT_ID=""
LLU_EU_REGION=EU
LLU_EU_TIMEZONE=Europe/Berlin
LLU_EU_UNITS=mmol

LLU_US_USERNAME=""
LLU_US_PASSWORD=""
LLU_US_PATIENT_ID=""
LLU_US_REGION=US
LLU_US_TIMEZONE=America/New_York
LLU_US_UNITS="mg/dl"

