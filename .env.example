CONNECT_SOURCE=glooko
CONNECT_GLOOKO_ENV=eu
CONNECT_GLOOKO_EMAIL=
CONNECT_GLOOKO_PASSWORD=
CONNECT_GLOOKO_TIMEZONE=Europe/London
CONNECT_GLOOKO_AUTH_MODE=api
CONNECT_GLOOKO_DATA_MODE=sync
# Glucose history and initial treatment update lookback, 1–90 days (sync mode).
CONNECT_GLOOKO_LOOKBACK_DAYS=14
CONNECT_GLOOKO_IMPORT_PROFILE=false
CONNECT_GLOOKO_USE_V3_GRAPH=true
CONNECT_GLOOKO_SKIP_ENTRIES=false
