# Source Nightscout (where to read data from)
CONNECT_SOURCE=nightscout
CONNECT_SOURCE_ENDPOINT=https://your-source.nightscout.site/?token=your-token-here
CONNECT_SOURCE_API_SECRET=your-source-api-secret

# Target Nightscout (where to write data to)
CONNECT_NIGHTSCOUT_ENDPOINT=https://your-target.nightscout.site
CONNECT_API_SECRET=your-target-api-secret

# Optional: Enable debug logging
CONNECT_DEBUG=false
